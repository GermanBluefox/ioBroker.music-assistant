    },
    "platform": "Javascript/Node.js",
    "icon": "music-assistant.png",
    "enabled": true,
    "nogit": true,
    "extIcon": "https://raw.githubusercontent.com/NurPech/ioBroker.music-assistant/main/admin/music-assistant.png",
    "readme": "https://github.com/NurPech/ioBroker.music-assistant/blob/main/README.md",
    "loglevel": "info",
    "tier": 3,
    "mode": "daemon",
    "type": "multimedia",
    "compact": true,
    "declareUsedResources": true,
    "connectionType": "local",
    "dataSource": "push",
    "adminUI": {
      "config": "json"
    },
    "plugins": {
      "docker": {
        "iobDockerComposeFiles": [
          "docker-compose.yaml"
        ]
      }
    },
    "stopTimeout": 10000,
    "dependencies": [
      {
        "js-controller": ">=6.0.11"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.7.2"
      }
    ]
  },
  "native": {
    "host": "",
    "port": 8095,
    "token": "",
    "username": "admin",
    "password": "",
    "dockerMusicAssistant": {
      "enabled": false,
      "stopIfInstanceStopped": true,
      "autoImageUpdate": true,
      "mediaFolder1": "",
      "mediaFolder2": "",
      "mediaFolder3": ""
    }
  },
  "encryptedNative": [
    "token",
    "password"
  ],
  "protectedNative": [
    "token",
    "password"
  ],
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "role": "indicator.connected",
        "name": "Device or service connected",
        "type": "boolean",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    }
  ]
}
